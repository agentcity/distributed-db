# =============================================================================
# distributed-db v2 compose — environment template
# =============================================================================
#
# Copy to `.env` next to the compose file and adjust as needed:
#
#   cp .env.compose.example .env
#
# The compose files read these variables with safe local-demo defaults, so the
# template can also be used as documentation without copying it. Nothing here
# is a secret: DB_ADMIN_TOKEN is empty by default and must be set explicitly
# for an admin-token-protected stack.
#
# This stack is for local development only: plaintext listeners, host-local
# named volumes, no TLS material. See the headers of docker-compose.yml and
# docker-compose.cluster.yml.
# =============================================================================

# --- image -------------------------------------------------------------------
# Tag used by every service. `build: .` is present in both compose files; the
# image is only rebuilt when --build is passed or the tag is missing locally.
DB_IMAGE=distributed-db:local

# --- common runtime ----------------------------------------------------------
# debug, info, warn, error
DB_LOG_LEVEL=info
# sync is the production default. "fast" skips state-machine fsyncs and is
# explicitly NOT production-safe; keep sync unless benchmarking.
DB_DURABILITY=sync

# Optional shared admin token for meta/KV admin RPCs. Empty means admin auth is
# disabled (development). There is no default secret.
#
# kv2 accepts this token only as a command-line flag, so it is visible in the
# container's process arguments on a shared host. It is not printed by compose
# and the bootstrap job passes it to kvctl through the environment only.
DB_ADMIN_TOKEN=

# --- demo host ports (docker-compose.yml) -----------------------------------
DB_SQL_PORT=8080
DB_META_PORT=9090
DB_KV_PORT=7001

# --- optional pgsrv host ports (docker-compose.cluster.yml, profile pgsrv) --
DB_PG_PORT=5432
DB_PG_METRICS_PORT=9187

# --- bootstrap job -----------------------------------------------------------
# Bounded leader wait, retry and verification settings for
# scripts/compose-bootstrap.sh.
DB_BOOTSTRAP_WAIT_TIMEOUT=180
DB_BOOTSTRAP_WAIT_INTERVAL=2
DB_BOOTSTRAP_INIT_ATTEMPTS=3
DB_BOOTSTRAP_VERIFY_ATTEMPTS=10
DB_BOOTSTRAP_KVCTL_TIMEOUT=10s

# --- profile shortcuts -------------------------------------------------------
# Uncomment exactly one to make plain `docker compose up` pick a stack:
#   demo  -> docker-compose.yml
#   cluster -> docker-compose.cluster.yml (still requires -f for the cluster
#              file; COMPOSE_PROFILES alone does not select a compose file)
# COMPOSE_PROFILES=demo
# COMPOSE_PROFILES=cluster
